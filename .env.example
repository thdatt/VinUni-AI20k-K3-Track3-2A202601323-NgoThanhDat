# Final lab run: choose groq or openai. "offline" is for deterministic tests only.
LLM_PROVIDER=groq

# Groq (recommended if you already use Groq)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# OpenAI alternative. OPENAI_BASE_URL also accepts any OpenAI-compatible
# endpoint (e.g. https://openrouter.ai/api/v1); leave blank for real OpenAI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# Offline corpus search (no web key required)
SEARCH_PROVIDER=offline
OFFLINE_CORPUS_PATH=data/offline_corpus

# Optional web search provider. The completed lab does not require it.
TAVILY_API_KEY=

# Optional external tracing
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=multi-agent-research-lab
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Runtime guardrails
APP_ENV=local
LOG_LEVEL=INFO
MAX_ITERATIONS=6
TIMEOUT_SECONDS=90
MAX_RETRIES=3
ENABLE_CRITIC=1

# Optional explicit prices per 1M tokens. Leave blank to report tokens instead of fake cost.
# INPUT_COST_PER_1M=
# OUTPUT_COST_PER_1M=
